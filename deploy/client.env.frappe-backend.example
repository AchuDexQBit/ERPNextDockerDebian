# Frappe-only backend (no ERPNext) — e.g. sparebox-stage on AWS.
# Copy to deploy/secrets/<client>.env and adjust. CI must match: empty CUSTOM_ERPNEXT_GITHUB_PATH,
# CUSTOM_WHITELIST_* for your app repo, BENCH_INSTALL_APPS = app folder name under bench/apps/.

CLIENT_ENV_FILE=secrets/sparebox_stage.env

GHCR_IMAGE=ghcr.io/dexqbit/erpnext-sparebox-stage:latest
ERPNext_HTTP_PORT=8082

RFP_DOMAIN_NAME=sparebox-stage.local
RFP_PUBLIC_URL=https://sparebox-stage.dexqbit.com
RFP_SITE_ADMIN_PASSWORD=
RFP_DB_HOST=db
RFP_DB_PORT=3306
RFP_DB_ROOT_PASSWORD=
RFP_REDIS_URL=redis://redis:6379
RFP_RECOVER_ORPHAN_SITE=false
RFP_MARIADB_USER_HOST_LOGIN_SCOPE=%

# Must match the folder name under bench/apps/ after bench get-app (not the GitHub repo name).
BENCH_INSTALL_APPS=sparebox_be
BENCH_EXTRA_APPS=
