# Copy to deploy/client.env (gitignored). Default Hetzner/AWS: deploy/compose.ghcr.yml + deploy/README.md §4.
# GHCR_IMAGE must match the branch CI built (.github/workflows/build.yml). For optional on-VPS build (§5), you can drop GHCR_IMAGE and use hetzner|aws docker-compose.yml instead.
#
# Path to this same file (required for compose.ghcr.yml to load vars into the container). If this file is
# deploy/client.env use ./client.env. If it is secrets/env.abc use secrets/env.abc (relative to compose.yml).
CLIENT_ENV_FILE=secrets/client.env

# --- Runtime (container) ---
GHCR_IMAGE=ghcr.io/your-org/erpnext-<client_name>-<env>:latest
# Use a different host port per stack when running several clients on one machine (e.g. 8080 / 8081).
ERPNext_HTTP_PORT=80
RFP_DOMAIN_NAME=site1.local
# If RFP_DOMAIN_NAME is site1.local (nginx), set real browser URL so links/OAuth use it (optional if same as site name).
RFP_PUBLIC_URL=https://erp.client.example.com
RFP_SITE_ADMIN_PASSWORD=ChangeMe_AdminPassword
RFP_DB_ROOT_PASSWORD=ChangeMe_MariaDBRoot
# e.g. payments hrms my_private_app — see deploy/README.md “Example: Payments + HRMS + one private app”
BENCH_EXTRA_APPS=

# --- Build-time (compose build args) ---
GITHUB_PAT_TOKEN=ghp_REPLACE_ME
# GitHub owner/repo only (no https or github.com); cloned at image build as your ERPNext app source.
CUSTOM_ERPNEXT_GITHUB_PATH=YourOrg/your-erpnext-fork
CUSTOM_ERPNEXT_BRANCH=main
# Private app owner/repo (build-time); install name goes in BENCH_EXTRA_APPS above.
CUSTOM_WHITELIST_GITHUB_PATH=
CUSTOM_WHITELIST_BRANCH=main
DEPLOY_TARGET=generic
